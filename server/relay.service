[Unit]
Description=Software Site Feishu Relay (Node)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/software-index/server
ExecStart=/usr/bin/node /var/www/software-index/server/dist/index.js
Restart=always
RestartSec=5

# 可选：飞书密钥（不设则用代码内置值）
# Environment=FEISHU_APP_SECRET=xxx
Environment=DEEPSEEK_API_KEY=REDACTED_DEEPSEEK_API_KEY
Environment=DEEPSEEK_API_URL_OpenAI=https://api.deepseek.com
Environment=FEISHU_CALENDAR_ID=7638812552629668820
Environment=REVIEW_PIN=123456

[Install]
WantedBy=multi-user.target
