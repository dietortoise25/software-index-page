# ===== 服务器连接信息 =====
# SSH 别名（定义在 ~/.ssh/config 中）
SERVER_HOST=your-server-alias
SERVER_IP=your.server.ip
SERVER_USER=root
SERVER_PORT=22

# SSH 私钥路径
SSH_KEY_PATH=C:\\Users\\YourName\\.ssh\\your_key

# ===== 网站部署路径 =====
# 服务器上 Nginx 静态文件根目录
DEPLOY_PATH=/var/www/software-site

# 下载文件目录（zip包存放位置）
DOWNLOADS_PATH=/downloads

# 下载文件访问 URL 前缀
DOWNLOADS_BASE_URL=http://your.server.ip/downloads

# ===== 飞书应用 =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxx
FEISHU_ADMIN_OPEN_ID=ou_xxxxxxxxxxxxx

# 飞书审批
FEISHU_APPROVAL_CODE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_APPROVER_OPEN_ID=ou_xxxxxxxxxxxxx
FEISHU_APPROVAL_NODE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书日历
FEISHU_CALENDAR_ID=xxxxxxxxxxxxxxx

# 飞书回调
FEISHU_ENCRYPT_KEY=xxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 管理员 =====
ADMIN_UNION_IDS=on_xxxxxxxxxxxxx
