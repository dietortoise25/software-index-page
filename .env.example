# ===== 服务器连接信息 =====
# SSH 别名（定义在 ~/.ssh/config 中）
SERVER_HOST=your-server-alias
SERVER_IP=your.server.ip
SERVER_USER=root
SERVER_PORT=22

# SSH 私钥路径
SSH_KEY_PATH=C:\\Users\\YourName\\.ssh\\your_key

# ===== 网站部署路径 =====
# 服务器上 Nginx 静态文件根目录
DEPLOY_PATH=/var/www/software-site

# 下载文件目录（zip包存放位置）
DOWNLOADS_PATH=/downloads

# 下载文件访问 URL 前缀
DOWNLOADS_BASE_URL=http://your.server.ip/downloads
