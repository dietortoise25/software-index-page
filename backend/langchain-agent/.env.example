# Agent 运行时平台 — 环境变量模板
# 复制为 .env 并填入实际值，大部分变量与根项目 .env 共享

# 服务端口
AGENT_PORT=8001

# LLM 全局默认配置（可被 Agent/节点级覆盖）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=<DEEPSEEK_API_KEY from root .env>
LLM_BASE_URL=<DEEPSEEK_API_URL_OpenAI from root .env>
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Step4 SKU 智能匹配专用 LLM（OpenAI 兼容，独立于 DeepSeek 默认配置）
# 由 shopee-analyzer 经 POST /api/agent/sku-match 调用
SKU_MATCH_API_KEY=<OpenAI 兼容 API key>
SKU_MATCH_MODEL=gpt-4o-mini
SKU_MATCH_BASE_URL=https://api.openai.com/v1

# 新闻汇总专用 LLM（OpenAI 兼容，独立于 DeepSeek 默认配置，缺失时回落到 LLM_*）
NEW_API_KEY=<OpenAI 兼容 API key>
NEW_API_URL=https://new.sakurapuare.com/v1
NEWS_SUMMARY_MODEL=gpt-5.5

# Supabase（与根项目共享）
SUPABASE_URL=<SUPABASE_URL from root .env>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY from root .env>
SUPABASE_SERVICE_ROLE_KEY=<secret key from Supabase Dashboard → Settings → API>
DATABASE_URL=<DATABASE_URL from root .env>

# Better Auth（复用现有认证，无 BETTER_AUTH_SECRET 则用数据库默认）
AUTH_BASE_URL=http://localhost:8765

# Tavily 搜索 API
TAVILY_API_KEY=<your tavily api key from tavily.com>

# 飞书（复用根项目凭据）
FEISHU_APP_ID=<FEISHU_APP_ID from root .env>
FEISHU_APP_SECRET=<FEISHU_APP_SECRET from root .env>
FEISHU_ADMIN_OPEN_ID=<FEISHU_ADMIN_OPEN_ID from root .env>

# Dev 模式（本地调试用，生产环境不要设置）
# AGENT_DEV_MODE=true
