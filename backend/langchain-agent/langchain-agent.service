[Unit]
Description=LangChain Agent Runtime Platform
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/software-index/agent
ExecStart=/usr/bin/node /var/www/software-index/agent/dist/index.js
Restart=always
RestartSec=5

# 端口（非密配置可留在此处）
Environment=AGENT_PORT=8001

# 所有密钥/连接串从 git 忽略的 .env 注入，不再硬编码进本文件。
# 需含：LLM_*（DeepSeek 默认）、NEW_API_*/NEWS_SUMMARY_MODEL（新闻专用 gpt-5.5）、
# SUPABASE_*、DATABASE_URL、AUTH_BASE_URL。该文件由运维在服务器维护，不进版本库。
EnvironmentFile=/var/www/software-index/agent/.env

[Install]
WantedBy=multi-user.target
