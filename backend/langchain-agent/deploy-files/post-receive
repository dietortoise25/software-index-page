#!/bin/bash
set -e

BUILD_DIR=/var/git/build
DEPLOY_DIR=/var/www/software-index
GIT_DIR=/var/git/software-index.git
ENV_FILE=/home/ubuntu/.env

echo "[deploy] $(date) - 开始部署..."

while read oldrev newrev refname; do
  if [ "$refname" != "refs/heads/main" ]; then
    echo "[deploy] 跳过 $refname (非 main 分支)"
    continue
  fi

  echo "[deploy] 检出代码..."
  git --work-tree="$BUILD_DIR" --git-dir="$GIT_DIR" checkout -f main

  echo "[deploy] 复制 .env..."
  cp "$ENV_FILE" "$BUILD_DIR/.env"
  cp "$ENV_FILE" "$BUILD_DIR/server/.env"

  echo "[deploy] 安装根依赖..."
  cd "$BUILD_DIR" && pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile

  echo "[deploy] 构建 platform..."
  cd "$BUILD_DIR/platform" && pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile && pnpm build

  echo "[deploy] 构建 server..."
  cd "$BUILD_DIR/server" && pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile && pnpm build

  echo "[deploy] 构建 agent..."
  cd "$BUILD_DIR/backend/langchain-agent" && pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile && pnpm build

  echo "[deploy] 构建前端..."
  cd "$BUILD_DIR" && pnpm build

  echo "[deploy] 部署前端..."
  mkdir -p "$DEPLOY_DIR"
  sudo chown -R ubuntu:ubuntu "$DEPLOY_DIR" 2>/dev/null || true
  rm -rf "$DEPLOY_DIR/assets" "$DEPLOY_DIR/index.html" "$DEPLOY_DIR/favicon.svg"
  cp -r "$BUILD_DIR/dist/"* "$DEPLOY_DIR/"

  echo "[deploy] 部署 server..."
  mkdir -p "$DEPLOY_DIR/server/dist"
  cp -r "$BUILD_DIR/server/dist/"* "$DEPLOY_DIR/server/dist/"
  cp "$BUILD_DIR/server/package.json" "$BUILD_DIR/server/pnpm-lock.yaml" "$DEPLOY_DIR/server/"
  cp "$ENV_FILE" "$DEPLOY_DIR/server/.env"
  sudo chown -R ubuntu:ubuntu "$DEPLOY_DIR/server" 2>/dev/null || true
  cd "$DEPLOY_DIR/server" && CI=true pnpm install --prod

  echo "[deploy] 部署 agent..."
  mkdir -p "$DEPLOY_DIR/agent/dist" "$DEPLOY_DIR/agent/patches"
  cp -r "$BUILD_DIR/backend/langchain-agent/dist/"* "$DEPLOY_DIR/agent/dist/"
  cp "$BUILD_DIR/backend/langchain-agent/package.json" "$BUILD_DIR/backend/langchain-agent/pnpm-lock.yaml" "$DEPLOY_DIR/agent/"
  cp -r "$BUILD_DIR/backend/langchain-agent/patches/"* "$DEPLOY_DIR/agent/patches/" 2>/dev/null || true
  sudo chown -R ubuntu:ubuntu "$DEPLOY_DIR/agent" 2>/dev/null || true
  cd "$DEPLOY_DIR/agent" && CI=true pnpm install --prod

  echo "[deploy] 部署 platform..."
  rm -rf "$DEPLOY_DIR/platform/dist"
  mkdir -p "$DEPLOY_DIR/platform/dist"
  cp -r "$BUILD_DIR/platform/dist/"* "$DEPLOY_DIR/platform/dist/"
  cp "$BUILD_DIR/platform/package.json" "$BUILD_DIR/platform/pnpm-lock.yaml" "$DEPLOY_DIR/platform/"
  sudo chown -R ubuntu:ubuntu "$DEPLOY_DIR/platform" 2>/dev/null || true
  cd "$DEPLOY_DIR/platform" && CI=true pnpm install --prod

  echo "[deploy] 部署 shopee-analyzer..."
  SHOPEE_SRC="$BUILD_DIR/backend/python/shopee-analyzer"
  SHOPEE_DIR="/var/www/shopee-analyzer"
  if [ -d "$SHOPEE_SRC" ]; then
    mkdir -p "$SHOPEE_DIR"
    rsync -a "$SHOPEE_SRC/" "$SHOPEE_DIR/" --exclude='.venv' --exclude='__pycache__'
    sudo chown -R ubuntu:ubuntu "$SHOPEE_DIR"
    cd "$SHOPEE_DIR"
    if [ ! -d ".venv" ]; then
      python3 -m venv .venv
    fi
    .venv/bin/pip install -q -r requirements.txt
    echo "[deploy] shopee-analyzer 代码已更新"
  else
    echo "[deploy] shopee-analyzer 源码目录不存在，跳过"
  fi

  # 安装/更新 langchain-agent systemd 服务
  if [ -f "$BUILD_DIR/backend/langchain-agent/langchain-agent.service" ]; then
    sudo cp "$BUILD_DIR/backend/langchain-agent/langchain-agent.service" /etc/systemd/system/langchain-agent.service
    sudo systemctl daemon-reload
    echo "[deploy] langchain-agent.service 已安装"
  fi

  echo "[deploy] 重启服务..."
  sudo fuser -k 8765/tcp 2>/dev/null || true
  sleep 1
  sudo systemctl restart relay qianyi-scheduler return-workflow shopee-analyzer langchain-agent
  sleep 3

  echo "[deploy] 验证..."
  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost/ 2>/dev/null || echo "000")
  echo "[deploy] HTTP $HTTP_CODE"
  SHOPEE_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8000/api/health 2>/dev/null || echo "000")
  echo "[deploy] shopee-analyzer $SHOPEE_CODE"
  AGENT_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8001/api/agent/health 2>/dev/null || echo "000")
  echo "[deploy] agent $AGENT_CODE"
  echo "[deploy] $(date) - 部署完成"
done
