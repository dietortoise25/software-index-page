[Unit]
Description=Qianyi ERP Data Sync Scheduler
After=network.target

[Service]
EnvironmentFile=-/home/ubuntu/.env
Type=simple
User=ubuntu
WorkingDirectory=/var/www/software-index/platform
ExecStart=/usr/bin/node /var/www/software-index/platform/dist/sync/scheduler.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
